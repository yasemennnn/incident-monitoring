{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=incidents;Username=incidents;Password=incidents",
    "Redis": "localhost:6379"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092,localhost:29093,localhost:29094",
    "Topic": "incident-events",
    "DeadLetterTopic": "incident-events-dlq",
    "GroupId": "incident-monitoring-api",
    "MaxAttempts": 3,
    "RetryDelayMs": 1000,
    "MaxRetryDelayMs": 30000
  },
  "DashboardProjection": {
    "RefreshIntervalSeconds": 30
  },
  "EventValidation": {
    "MaxFutureSkew": "00:05:00"
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:4200"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
